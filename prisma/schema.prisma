
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────
// ORGANIZATION & USERS
// ─────────────────────────────────────────────────

model Organization {
  id                    String              @id @default(cuid())
  name                  String
  plan                  String              @default("TRIAL")   // TRIAL | SOLO | FIRM | ENTERPRISE
  trialEndsAt           DateTime?
  // Stripe billing
  stripeCustomerId      String?             @unique
  stripeSubscriptionId  String?             @unique
  stripePriceId         String?
  subscriptionStatus    String              @default("TRIAL")   // TRIAL | ACTIVE | PAST_DUE | CANCELED | PAUSED
  currentPeriodEnd      DateTime?
  casesLimit            Int                 @default(3)
  usersLimit            Int                 @default(1)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  users                 User[]
  cases                 Case[]
  connectors            ExternalConnector[]
  aiExecutions          AiExecution[]
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  password       String
  name           String
  role           String       @default("EDITOR")  // ADMIN | EDITOR | REVIEWER | VIEWER
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  auditLogs      AuditLog[]
  // Slice 2 — auth hardening
  emailVerifiedAt         DateTime?
  passwordChangedAt       DateTime?
  mfaEnabled              Boolean                  @default(false)
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  sessionRevocations      SessionRevocation[]
  mfaSecret               MfaSecret?
  mfaBackupCodes          MfaBackupCode[]
  aiExecutions            AiExecution[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// ─────────────────────────────────────────────────
// CASES (ENGAGEMENTS)
// ─────────────────────────────────────────────────

model Case {
  id               String                  @id @default(cuid())
  name             String
  client           String
  type             String
  manager          String
  status           String                  @default("ACTIVE") // ACTIVE | REVIEW | CLOSED | ARCHIVED
  purposeOfValue   String?
  standardOfValue  String?                 @default("FMV")    // FMV | FV | IV | BEV
  valuationDate    DateTime?
  reportDueDate    DateTime?
  organizationId   String
  organization     Organization            @relation(fields: [organizationId], references: [id])
  documents        Document[]
  financialData    FinancialValue[]
  addBacks         AddBack[]
  industry         IndustryClassification?
  valuationModels  ValuationModel[]
  anomalyFlags     AnomalyFlag[]
  auditLogs        AuditLog[]
  insights         CaseInsight[]
  ttmReport        Json?                   // persisted normalized TTM report — avoids re-running AI on reload
  aiExecutions     AiExecution[]
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
}

// ─────────────────────────────────────────────────
// DOCUMENTS
// ─────────────────────────────────────────────────

model Document {
  id             String           @id @default(cuid())
  caseId         String
  case           Case             @relation(fields: [caseId], references: [id], onDelete: Cascade)
  name           String
  type           String
  size           String
  s3Key          String?
  sha256Hash     String?          // tamper-evident integrity hash of the current version
  status         String           @default("PENDING") // PENDING | EXTRACTED | VERIFIED | REJECTED
  pageCount      Int?
  financialValues FinancialValue[]
  // ── Slice 5: versioning + archival ───────────────────────────────────
  // Denormalized pointer to the latest non-archived DocumentVersion. Kept
  // in sync by addDocument; readers that only need the current file can
  // continue to use Document.s3Key / Document.sha256Hash without joining.
  currentVersionId String?
  currentVersion   DocumentVersion? @relation("CurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions         DocumentVersion[] @relation("DocumentVersions")
  // Soft-delete flag. deleteDocument sets this true; the row and S3 objects
  // are retained (chain of custody). A future admin-only hard-delete slice
  // can add real destruction with legal-hold checks.
  isArchived       Boolean          @default(false)
  archivedAt       DateTime?
  archivedBy       String?
  archiveReason    String?          @db.Text
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([caseId, isArchived])
}

// Immutable per-upload version. Every re-upload creates a new row —
// existing rows are never updated except to flip `isArchived`. The pair
// (documentId, versionNumber) is a stable public identifier.
model DocumentVersion {
  id            String   @id @default(cuid())
  documentId    String
  document      Document @relation("DocumentVersions", fields: [documentId], references: [id], onDelete: Cascade)
  versionNumber Int      // 1, 2, 3… per document
  s3Key         String   // orgs/<org>/cases/<case>/documents/<doc>/versions/<n>/<name>
  sha256Hash    String   // per-version — independent of any other version's hash
  sizeBytes     BigInt
  mimeType      String   // detected via magic-byte sniff, not client-declared
  originalName  String   // the filename as the analyst uploaded it
  uploadedBy    String   // userId (nullable string for legacy backfill placeholder)
  uploadedAt    DateTime @default(now())

  // Malware scan hook — populated asynchronously by the scanner. NullScanner
  // (default) transitions PENDING → CLEAN on upload; a real scanner would
  // enqueue a job and update later. INFECTED versions cannot be downloaded.
  scanStatus    String   @default("PENDING") // PENDING | SCANNING | CLEAN | INFECTED | ERROR
  scanReport    String?  @db.Text
  scannedAt     DateTime?

  // Soft-delete at the version level. Archiving a version does not archive
  // its parent Document; it only hides that specific upload.
  isArchived    Boolean  @default(false)
  archivedAt    DateTime?
  archivedBy    String?
  archiveReason String?  @db.Text

  currentFor    Document[] @relation("CurrentVersion")
  // Slice 7 — every citation points at a specific immutable version, so a
  // future re-upload cannot invalidate the citation.
  citations     EvidenceCitation[]

  @@unique([documentId, versionNumber])
  @@index([sha256Hash])
  @@index([documentId, isArchived])
}

// ─────────────────────────────────────────────────
// FINANCIAL VALUES (Hybrid AI + Human)
// ─────────────────────────────────────────────────

model FinancialValue {
  id               String    @id @default(cuid())
  caseId           String
  case             Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  documentId       String?
  document         Document? @relation(fields: [documentId], references: [id])
  year             String
  statementType    String
  lineItem         String
  value            Float
  aiSuggestedValue Float?    // original AI-extracted value (immutable reference)
  confidence       Float?    // 0.0–1.0 from AI
  // Slice 4 — decimal-safe shadow columns (Float above kept for read-fallback + UI display).
  valueDecimal            Decimal? @db.Decimal(19, 4)
  aiSuggestedValueDecimal Decimal? @db.Decimal(19, 4)
  sourceRef        String?   // e.g. "page 4, table 2, row 'Gross receipts'"
  currency         String    @default("USD")
  isVerified       Boolean   @default(false)
  isLocked         Boolean   @default(false)   // locked values never overwritten by re-runs
  reviewStatus     String    @default("PENDING") // PENDING | ACCEPTED | OVERRIDDEN | REJECTED
  overrideReason   String?   @db.Text
  overriddenBy     String?   // userId
  overriddenAt     DateTime?
  // Slice 7 — evidence-level citations. Every material extracted value can
  // have one or more citations pointing at the immutable DocumentVersion
  // where it was found. `sourceRef` (Slice 0 legacy string) remains as-is
  // for backward-compat readers.
  citations        EvidenceCitation[]
  // Slice 8 — trace back to the AI execution that proposed this value.
  // NULL for hand-entered rows and pre-Slice-8 extractions.
  aiExecutionId    String?
  aiExecution      AiExecution? @relation(fields: [aiExecutionId], references: [id])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([aiExecutionId])
}

// ─────────────────────────────────────────────────
// NORMALIZATION ADD-BACKS
// ─────────────────────────────────────────────────

model AddBack {
  id              String   @id @default(cuid())
  caseId          String
  case            Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  category        String   // OWNER_COMP | PERSONAL_EXPENSE | NON_RECURRING | RENT_ADJUSTMENT | DEPRECIATION | NON_CASH | OTHER
  description     String
  year2           Float?   // 2 years ago
  year1           Float?   // last full year
  ttm             Float?   // trailing twelve months
  aiSuggested     Boolean  @default(false)
  confidence      Float?
  // Slice 4 — decimal-safe shadow columns
  year2Decimal    Decimal? @db.Decimal(19, 4)
  year1Decimal    Decimal? @db.Decimal(19, 4)
  ttmDecimal      Decimal? @db.Decimal(19, 4)
  rationale       String?  @db.Text // required before report generation
  isApproved      Boolean  @default(false)
  approvedBy      String?
  // Slice 7 — citations for the source documents an add-back derives from.
  citations       EvidenceCitation[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─────────────────────────────────────────────────
// INDUSTRY CLASSIFICATION
// ─────────────────────────────────────────────────

model IndustryClassification {
  id                String   @id @default(cuid())
  caseId            String   @unique
  case              Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  suggestedIndustry String
  naicsCode         String?
  sicCode           String?
  description       String?  @db.Text
  confidence        Float?
  createdAt         DateTime @default(now())
}

// ─────────────────────────────────────────────────
// VALUATION MODELS (all approaches)
// ─────────────────────────────────────────────────

model ValuationModel {
  id               String   @id @default(cuid())
  caseId           String
  case             Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  valuationType    String   // MARKET_APPROACH | DCF | ASSET_BASED | BLENDED
  label            String?  // e.g. "Market Approach — EBITDA Multiple"

  // Market approach (EBITDA multiple / GPCM)
  ebitda           Float?
  multiplier       Float?
  growthRate       Float?

  // DCF inputs
  dcfYear1         Float?
  dcfYear2         Float?
  dcfYear3         Float?
  dcfYear4         Float?
  dcfYear5         Float?
  terminalGrowth   Float?   @default(0.03)
  discountRate     Float?   @default(0.20)  // WACC
  // WACC components
  riskFreeRate     Float?
  equityRiskPremium Float?
  sizePremium      Float?
  specificRisk     Float?

  // Concluded value
  indicatedValue   Float?
  weight           Float?   @default(1.0)  // weighting in reconciliation (0–1)

  // Reconciliation notes
  reconciliationNote String? @db.Text

  // Slice 4 — decimal-safe shadow columns.
  //  - Money fields: Decimal(19, 4)
  //  - Rates / multiples / weights: Decimal(9, 6)
  ebitdaDecimal            Decimal? @db.Decimal(19, 4)
  multiplierDecimal        Decimal? @db.Decimal(9,  6)
  growthRateDecimal        Decimal? @db.Decimal(9,  6)
  dcfYear1Decimal          Decimal? @db.Decimal(19, 4)
  dcfYear2Decimal          Decimal? @db.Decimal(19, 4)
  dcfYear3Decimal          Decimal? @db.Decimal(19, 4)
  dcfYear4Decimal          Decimal? @db.Decimal(19, 4)
  dcfYear5Decimal          Decimal? @db.Decimal(19, 4)
  terminalGrowthDecimal    Decimal? @db.Decimal(9,  6)
  discountRateDecimal      Decimal? @db.Decimal(9,  6)
  riskFreeRateDecimal      Decimal? @db.Decimal(9,  6)
  equityRiskPremiumDecimal Decimal? @db.Decimal(9,  6)
  sizePremiumDecimal       Decimal? @db.Decimal(9,  6)
  specificRiskDecimal      Decimal? @db.Decimal(9,  6)
  indicatedValueDecimal    Decimal? @db.Decimal(19, 4)
  weightDecimal            Decimal? @db.Decimal(9,  6)
  // Slice 7 — valuation assumptions (WACC components, multiples, DCF cash
  // flows) can eventually be traced back to source evidence. The relation
  // is here now; UI wire-in is a future slice.
  citations                EvidenceCitation[]

  createdAt        DateTime @default(now())
}

// ─────────────────────────────────────────────────
// FORENSIC ANOMALY FLAGS
// ─────────────────────────────────────────────────

model AnomalyFlag {
  id           String   @id @default(cuid())
  caseId       String
  case         Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  severity     String   // HIGH | MEDIUM | LOW
  category     String   // BENFORD | OUTLIER | RELATED_PARTY | RATIO_BREAK | DUPLICATE | MARGIN_SHIFT
  title        String
  description  String   @db.Text
  affectedRows String?  @db.Text // JSON array of FinancialValue IDs
  status       String   @default("OPEN") // OPEN | INVESTIGATED | EXPLAINED | ESCALATED
  resolution   String?  @db.Text
  resolvedBy   String?
  resolvedAt   DateTime?
  createdAt    DateTime @default(now())
}

// ─────────────────────────────────────────────────
// PROACTIVE AI INSIGHTS
// ─────────────────────────────────────────────────

model CaseInsight {
  id          String   @id @default(cuid())
  caseId      String
  case        Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  type        String   // ANOMALY | MISSING_DOC | SUGGESTION | WARNING | COMPLETION
  title       String
  body        String   @db.Text
  actionLabel String?
  actionPath  String?
  isDismissed Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// ─────────────────────────────────────────────────
// AUDIT TRAIL (chain of custody)
// ─────────────────────────────────────────────────

model AuditLog {
  id          String   @id @default(cuid())
  caseId      String?
  case        Case?    @relation(fields: [caseId], references: [id])
  // Slice 2 — auth events like LOGIN_FAIL for an unknown email have no user.
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  action      String   // UPLOAD_DOC | RUN_EXTRACTION | ACCEPT_VALUE | OVERRIDE_VALUE | REJECT_VALUE | LOCK_VALUE | APPROVE_BATCH | CREATE_CASE | GENERATE_REPORT | RUN_ANOMALY | LOGIN_* | LOGOUT | PASSWORD_* | etc.
  targetModel String?  // "FinancialValue" | "Document" | "AddBack" | "ValuationModel"
  targetId    String?
  oldValue    String?  @db.Text  // JSON
  newValue    String?  @db.Text  // JSON
  note        String?  @db.Text
  ipAddress   String?
  createdAt   DateTime @default(now())
  // ── Slice 6: tamper-evident hash chain ───────────────────────────────
  // Rows written before Slice 6 have all of these NULL and are treated by
  // the verifier as "pre-chain" (skipped, not counted as tamper). New
  // events form a chain keyed by `chainKey` and ordered by `sequence`.
  // `eventHash` = SHA-256(canonicalPayload including previousHash).
  chainKey     String?  // 'org:<id>' | 'global:anon'
  sequence     Int?     // per-chainKey monotonic; enforced by @@unique below
  previousHash String?  @db.VarChar(64)   // hex sha-256, or null for the genesis row
  eventHash    String?  @db.VarChar(64)
  hashVersion  String?  @db.VarChar(8)    // 'v1' for the current canonical format

  @@index([caseId, createdAt])
  @@index([userId])
  @@index([action, createdAt])
  @@index([chainKey, sequence])
  @@unique([chainKey, sequence], name: "AuditLog_chainKey_sequence_key")
}

// ─────────────────────────────────────────────────
// EXTERNAL CONNECTORS
// ─────────────────────────────────────────────────

model ExternalConnector {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  provider       String
  // Legacy plaintext columns retained during migration to envelope encryption.
  // Cleared on every new write by encryptConnectorSecrets(). Rows that still
  // carry plaintext here have not yet been passed through the Slice 3
  // migration script.
  accessToken    String?      @db.Text
  refreshToken   String?      @db.Text
  // Slice 3 — envelope-encrypted secrets.
  // Shape: { version: 'v1', secrets: { <name>: { ciphertext, dek } } }
  encryptedSecrets     Json?
  // Which KEK produced the wrap ('kms:<arn>' or 'local-v1'); used by
  // rotation queries to find rows still keyed to an old KEK.
  encryptionKeyVersion String?
  expiresAt      DateTime?
  status         String       @default("CONNECTED")
  lastSync       DateTime?    @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, provider])
  @@index([encryptionKeyVersion])
}

// ─────────────────────────────────────────────────
// AUTH HARDENING (Slice 2)
// ─────────────────────────────────────────────────

// Records the jti of each revoked session JWT so getSession() can reject
// cookies that are otherwise cryptographically valid. Rows are pruned
// after their originating token's natural expiry.
model SessionRevocation {
  jti        String   @id                    // JWT jti
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  reason     String                          // LOGOUT | PASSWORD_CHANGE | ADMIN | SUSPICIOUS
  revokedAt  DateTime @default(now())
  expiresAt  DateTime                        // when the underlying JWT would've expired

  @@index([expiresAt])
  @@index([userId])
}

// SHA-256(raw token) is the primary key — the raw token exists only in
// the outgoing email. Consumed tokens are retained (audit trail) but
// cannot be re-used because of the consumedAt check.
model PasswordResetToken {
  tokenHash  String    @id
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, expiresAt])
}

model EmailVerificationToken {
  tokenHash  String    @id
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, expiresAt])
}

// One row per real login attempt (rejected-by-rate-limit attempts do NOT
// write here — they only emit an AuditLog LOGIN_RATE_LIMITED event).
// Used by the rate limiter and by anomaly-detection dashboards.
model LoginAttempt {
  id         String   @id @default(cuid())
  email      String                          // normalized lowercase
  ipAddress  String?
  ok         Boolean
  reason     String?                         // BAD_PASSWORD | UNKNOWN_USER | MFA_FAIL
  createdAt  DateTime @default(now())

  @@index([email, createdAt])
  @@index([createdAt])
}

// TOTP shared secret. verifiedAt remains null while enrollment is
// pending; a successful first code sets it.
model MfaSecret {
  userId     String    @id
  user       User      @relation(fields: [userId], references: [id])
  secret     String                          // base32 TOTP shared secret
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// Single-use recovery codes; codeHash = SHA-256(plaintext). Used codes
// are retained for audit but cannot be re-consumed.
model MfaBackupCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ─────────────────────────────────────────────────
// EVIDENCE CITATIONS (Slice 7)
// ─────────────────────────────────────────────────
// A citation ties a material forensic value (FinancialValue, AddBack, or
// a valuation assumption on ValuationModel) back to a specific,
// *immutable* DocumentVersion. Slice 5's version model guarantees that a
// citation to v2 remains valid even when v3 supersedes it — the bytes
// referenced by v2 don't change.
//
// isConfident is the anti-hallucination guard. When the AI can't
// confidently locate a value, it emits a citation with isConfident=false
// and NULLs the coordinate fields. The row still exists so the UI can
// distinguish "AI tried but couldn't locate" from "no citation attempt
// at all". Rule 9.
model EvidenceCitation {
  id                String   @id @default(cuid())
  documentVersionId String
  documentVersion   DocumentVersion @relation(fields: [documentVersionId], references: [id])

  // Polymorphic parent — exactly one of these is set per row. Enforced
  // by application logic (see src/lib/citations/parent.ts) since Prisma
  // does not have a native discriminated-relation type.
  financialValueId  String?
  financialValue    FinancialValue? @relation(fields: [financialValueId], references: [id], onDelete: Cascade)
  addBackId         String?
  addBack           AddBack?        @relation(fields: [addBackId], references: [id], onDelete: Cascade)
  valuationModelId  String?
  valuationModel    ValuationModel? @relation(fields: [valuationModelId], references: [id], onDelete: Cascade)

  // Location within the source document.
  pageNumber        Int?
  sourceLabel       String?  // human-readable, e.g. "Income Statement, row 'Gross Revenue'"
  tableName         String?
  rowLabel          String?
  columnLabel       String?
  // Optional structured bounding box: { x, y, w, h, unit: 'norm'|'pt'|'px' }.
  // Different extractors use different conventions; we record the unit
  // alongside the coordinates so the renderer can interpret them.
  boundingBox       Json?

  // Raw substring captured at extraction time.
  rawText           String?  @db.Text

  // Extractor provenance.
  extractor         String?  // 'ai-genkit-v1' | 'analyst' | 'legacy-backfill'
  extractorVersion  String?
  confidence        Float?

  // Anti-hallucination flag. False when the AI (or legacy backfill) had
  // to record a citation without being able to pin the actual location.
  isConfident       Boolean  @default(true)

  createdAt         DateTime @default(now())

  @@index([documentVersionId])
  @@index([financialValueId])
  @@index([addBackId])
  @@index([valuationModelId])
}

// ─────────────────────────────────────────────────
// AI EXECUTION REGISTRY (Slice 8)
// ─────────────────────────────────────────────────
// Every user-triggered AI flow invocation writes exactly one row here.
// The row records who ran what, against which document versions, and
// what came out — WITHOUT ever storing the raw prompt, the raw model
// output, or the document bytes. The input hash is computed after
// scrubbing data URIs and known secret keys.
//
// Values proposed by an AI run link back via FinancialValue.aiExecutionId,
// so any material fact can be traced to a single execution + a single
// prompt-template hash + a single set of source DocumentVersion IDs.
model AiExecution {
  id                 String   @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id])
  caseId             String?
  case               Case?    @relation(fields: [caseId], references: [id])
  userId             String
  user               User     @relation(fields: [userId], references: [id])

  // Flow identity
  flowName           String   // 'financialDocumentExtractionFlow' | ...
  flowVersion        String?  // human label, bumped alongside the prompt
  promptTemplateHash String?  // sha256 of the prompt template body, auto-computed
  promptTemplateKey  String?  // stable key that survives whitespace edits

  // Model identity
  modelProvider      String   // 'googleai'
  modelName          String   // 'gemini-2.5-flash'
  modelVersion       String?  // if the API exposes one

  // Data provenance (never the document bytes themselves)
  inputHash          String   // sha256 of the scrubbed canonicalized input
  outputHash         String?  // sha256 of the canonicalized output (null on failure)
  // JSON array of DocumentVersion ids that fed this execution. Slice 5
  // guarantees those versions are immutable, so this list is enough to
  // reproduce the source-document identity of any given run.
  documentVersionIds Json?

  // Timing + status
  startedAt          DateTime @default(now())
  completedAt        DateTime?
  durationMs         Int?
  status             String   @default("RUNNING") // RUNNING | SUCCESS | FAILURE
  errorCategory      String?  // MODEL_TIMEOUT | SCHEMA_VALIDATION | RATE_LIMIT | REFUSED | INFRA | UNKNOWN
  errorMessage       String?  @db.Text

  // Cost / tokens — optional; populated when the model exposes them.
  inputTokens        Int?
  outputTokens       Int?
  totalTokens        Int?
  estimatedCostUsd   Decimal? @db.Decimal(10, 6)

  // Aggregate human review of the run. Individual FinancialValue
  // reviewStatus already tracks per-row acceptance; this column is the
  // "execution as a whole" verdict, updated explicitly (not derived).
  reviewStatus       String   @default("PENDING") // PENDING | ACCEPTED | REJECTED | OVERRIDDEN | MIXED
  reviewedBy         String?
  reviewedAt         DateTime?

  createdAt          DateTime @default(now())

  financialValues    FinancialValue[]

  @@index([organizationId, createdAt])
  @@index([caseId, createdAt])
  @@index([userId])
  @@index([flowName, createdAt])
  @@index([status])
}
