
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────
// ORGANIZATION & USERS
// ─────────────────────────────────────────────────

model Organization {
  id                    String              @id @default(cuid())
  name                  String
  plan                  String              @default("TRIAL")   // TRIAL | SOLO | FIRM | ENTERPRISE
  trialEndsAt           DateTime?
  // Stripe billing
  stripeCustomerId      String?             @unique
  stripeSubscriptionId  String?             @unique
  stripePriceId         String?
  subscriptionStatus    String              @default("TRIAL")   // TRIAL | ACTIVE | PAST_DUE | CANCELED | PAUSED
  currentPeriodEnd      DateTime?
  casesLimit            Int                 @default(3)
  usersLimit            Int                 @default(1)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  users                 User[]
  cases                 Case[]
  connectors            ExternalConnector[]
  aiExecutions          AiExecution[]
  // Slice 12 — firm-owned request-list templates.
  requestTemplates      RequestTemplate[]
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  password       String
  name           String
  role           String       @default("EDITOR")  // ADMIN | EDITOR | REVIEWER | VIEWER
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  auditLogs      AuditLog[]
  // Slice 2 — auth hardening
  emailVerifiedAt         DateTime?
  passwordChangedAt       DateTime?
  mfaEnabled              Boolean                  @default(false)
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  sessionRevocations      SessionRevocation[]
  mfaSecret               MfaSecret?
  mfaBackupCodes          MfaBackupCode[]
  aiExecutions            AiExecution[]
  // Slice 11 — engagement-level access
  caseMemberships         CaseMember[]
  reviewComments          ReviewComment[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// ─────────────────────────────────────────────────
// CASES (ENGAGEMENTS)
// ─────────────────────────────────────────────────

model Case {
  id               String                  @id @default(cuid())
  name             String
  client           String
  type             String
  manager          String
  status           String                  @default("ACTIVE") // ACTIVE | REVIEW | CLOSED | ARCHIVED
  purposeOfValue   String?
  standardOfValue  String?                 @default("FMV")    // FMV | FV | IV | BEV
  valuationDate    DateTime?
  reportDueDate    DateTime?
  organizationId   String
  organization     Organization            @relation(fields: [organizationId], references: [id])
  documents        Document[]
  financialData    FinancialValue[]
  addBacks         AddBack[]
  industry         IndustryClassification?
  valuationModels  ValuationModel[]
  anomalyFlags     AnomalyFlag[]
  auditLogs        AuditLog[]
  insights         CaseInsight[]
  ttmReport        Json?                   // persisted normalized TTM report — avoids re-running AI on reload
  aiExecutions     AiExecution[]
  tieOuts          TieOut[]
  // Slice 11 — engagement-level access control.
  // When false, whole-org access still applies (Slice 1 semantics).
  // When true, only CaseMembers (and org ADMINs) can reach the case.
  // The flag is monotonic: adding the first CaseMember flips it to true
  // and it stays true even if every member is later removed.
  hasEngagementTeam Boolean                @default(false)
  members          CaseMember[]
  reviewItems      ReviewItem[]
  // Slice 12 — request lists (PBC) and client portal contacts.
  requestLists     RequestList[]
  clientContacts   ClientContact[]
  portalAccesses   PortalAccess[]
  requestItems     RequestItem[]
  reminderEvents   ReminderEvent[]
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
}

// ─────────────────────────────────────────────────
// DOCUMENTS
// ─────────────────────────────────────────────────

model Document {
  id             String           @id @default(cuid())
  caseId         String
  case           Case             @relation(fields: [caseId], references: [id], onDelete: Cascade)
  name           String
  type           String
  size           String
  s3Key          String?
  sha256Hash     String?          // tamper-evident integrity hash of the current version
  status         String           @default("PENDING") // PENDING | EXTRACTED | VERIFIED | REJECTED
  pageCount      Int?
  financialValues FinancialValue[]
  // ── Slice 5: versioning + archival ───────────────────────────────────
  // Denormalized pointer to the latest non-archived DocumentVersion. Kept
  // in sync by addDocument; readers that only need the current file can
  // continue to use Document.s3Key / Document.sha256Hash without joining.
  currentVersionId String?
  currentVersion   DocumentVersion? @relation("CurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions         DocumentVersion[] @relation("DocumentVersions")
  // Soft-delete flag. deleteDocument sets this true; the row and S3 objects
  // are retained (chain of custody). A future admin-only hard-delete slice
  // can add real destruction with legal-hold checks.
  isArchived       Boolean          @default(false)
  archivedAt       DateTime?
  archivedBy       String?
  archiveReason    String?          @db.Text
  // Slice 12 — attach documents to a client-facing RequestItem.
  requestItemLinks RequestItemDocument[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([caseId, isArchived])
}

// Immutable per-upload version. Every re-upload creates a new row —
// existing rows are never updated except to flip `isArchived`. The pair
// (documentId, versionNumber) is a stable public identifier.
model DocumentVersion {
  id            String   @id @default(cuid())
  documentId    String
  document      Document @relation("DocumentVersions", fields: [documentId], references: [id], onDelete: Cascade)
  versionNumber Int      // 1, 2, 3… per document
  s3Key         String   // orgs/<org>/cases/<case>/documents/<doc>/versions/<n>/<name>
  sha256Hash    String   // per-version — independent of any other version's hash
  sizeBytes     BigInt
  mimeType      String   // detected via magic-byte sniff, not client-declared
  originalName  String   // the filename as the analyst uploaded it
  uploadedBy    String   // userId (nullable string for legacy backfill placeholder)
  uploadedAt    DateTime @default(now())

  // Malware scan hook — populated asynchronously by the scanner. NullScanner
  // (default) transitions PENDING → CLEAN on upload; a real scanner would
  // enqueue a job and update later. INFECTED versions cannot be downloaded.
  scanStatus    String   @default("PENDING") // PENDING | SCANNING | CLEAN | INFECTED | ERROR
  scanReport    String?  @db.Text
  scannedAt     DateTime?

  // Soft-delete at the version level. Archiving a version does not archive
  // its parent Document; it only hides that specific upload.
  isArchived    Boolean  @default(false)
  archivedAt    DateTime?
  archivedBy    String?
  archiveReason String?  @db.Text

  currentFor    Document[] @relation("CurrentVersion")
  // Slice 7 — every citation points at a specific immutable version, so a
  // future re-upload cannot invalidate the citation.
  citations     EvidenceCitation[]
  // Slice 9 — tie-out items may reference this specific version.
  tieOutItems   TieOutItem[]

  @@unique([documentId, versionNumber])
  @@index([sha256Hash])
  @@index([documentId, isArchived])
}

// ─────────────────────────────────────────────────
// FINANCIAL VALUES (Hybrid AI + Human)
// ─────────────────────────────────────────────────

model FinancialValue {
  id               String    @id @default(cuid())
  caseId           String
  case             Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  documentId       String?
  document         Document? @relation(fields: [documentId], references: [id])
  year             String
  statementType    String
  lineItem         String
  value            Float
  aiSuggestedValue Float?    // original AI-extracted value (immutable reference)
  confidence       Float?    // 0.0–1.0 from AI
  // Slice 4 — decimal-safe shadow columns (Float above kept for read-fallback + UI display).
  valueDecimal            Decimal? @db.Decimal(19, 4)
  aiSuggestedValueDecimal Decimal? @db.Decimal(19, 4)
  sourceRef        String?   // e.g. "page 4, table 2, row 'Gross receipts'"
  currency         String    @default("USD")
  isVerified       Boolean   @default(false)
  isLocked         Boolean   @default(false)   // locked values never overwritten by re-runs
  reviewStatus     String    @default("PENDING") // PENDING | ACCEPTED | OVERRIDDEN | REJECTED
  overrideReason   String?   @db.Text
  overriddenBy     String?   // userId
  overriddenAt     DateTime?
  // Slice 7 — evidence-level citations. Every material extracted value can
  // have one or more citations pointing at the immutable DocumentVersion
  // where it was found. `sourceRef` (Slice 0 legacy string) remains as-is
  // for backward-compat readers.
  citations        EvidenceCitation[]
  // Slice 8 — trace back to the AI execution that proposed this value.
  // NULL for hand-entered rows and pre-Slice-8 extractions.
  aiExecutionId    String?
  aiExecution      AiExecution? @relation(fields: [aiExecutionId], references: [id])
  // Slice 9 — feeds tie-out reconciliation items.
  tieOutItems      TieOutItem[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([aiExecutionId])
}

// ─────────────────────────────────────────────────
// NORMALIZATION ADD-BACKS
// ─────────────────────────────────────────────────

model AddBack {
  id              String   @id @default(cuid())
  caseId          String
  case            Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  category        String   // OWNER_COMP | PERSONAL_EXPENSE | NON_RECURRING | RENT_ADJUSTMENT | DEPRECIATION | NON_CASH | OTHER
  description     String
  year2           Float?   // 2 years ago
  year1           Float?   // last full year
  ttm             Float?   // trailing twelve months
  aiSuggested     Boolean  @default(false)
  confidence      Float?
  // Slice 4 — decimal-safe shadow columns
  year2Decimal    Decimal? @db.Decimal(19, 4)
  year1Decimal    Decimal? @db.Decimal(19, 4)
  ttmDecimal      Decimal? @db.Decimal(19, 4)
  rationale       String?  @db.Text // required before report generation
  isApproved      Boolean  @default(false)
  approvedBy      String?
  // Slice 7 — citations for the source documents an add-back derives from.
  citations       EvidenceCitation[]
  // Slice 10 — normalization workbench fields.
  //   status is the primary state; `isApproved` above is kept in sync
  //   (isApproved == (status == 'APPROVED')) for backward-compat readers.
  status          String    @default("DRAFT")   // DRAFT | PROPOSED | NEEDS_SUPPORT | APPROVED | REJECTED
  direction       String    @default("ADD")     // ADD | SUBTRACT
  recurring       String    @default("NONRECURRING") // RECURRING | NONRECURRING | ONE_TIME
  taxTreatment    String?                       // PRE_TAX | AFTER_TAX | NOT_APPLICABLE
  proposedBy      String?
  reviewedBy      String?
  reviewedAt      DateTime?
  statusChangedAt DateTime?
  rejectionReason String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([caseId, status])
  @@index([status])
}

// ─────────────────────────────────────────────────
// INDUSTRY CLASSIFICATION
// ─────────────────────────────────────────────────

model IndustryClassification {
  id                String   @id @default(cuid())
  caseId            String   @unique
  case              Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  suggestedIndustry String
  naicsCode         String?
  sicCode           String?
  description       String?  @db.Text
  confidence        Float?
  createdAt         DateTime @default(now())
}

// ─────────────────────────────────────────────────
// VALUATION MODELS (all approaches)
// ─────────────────────────────────────────────────

model ValuationModel {
  id               String   @id @default(cuid())
  caseId           String
  case             Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  valuationType    String   // MARKET_APPROACH | DCF | ASSET_BASED | BLENDED
  label            String?  // e.g. "Market Approach — EBITDA Multiple"

  // Market approach (EBITDA multiple / GPCM)
  ebitda           Float?
  multiplier       Float?
  growthRate       Float?

  // DCF inputs
  dcfYear1         Float?
  dcfYear2         Float?
  dcfYear3         Float?
  dcfYear4         Float?
  dcfYear5         Float?
  terminalGrowth   Float?   @default(0.03)
  discountRate     Float?   @default(0.20)  // WACC
  // WACC components
  riskFreeRate     Float?
  equityRiskPremium Float?
  sizePremium      Float?
  specificRisk     Float?

  // Concluded value
  indicatedValue   Float?
  weight           Float?   @default(1.0)  // weighting in reconciliation (0–1)

  // Reconciliation notes
  reconciliationNote String? @db.Text

  // Slice 4 — decimal-safe shadow columns.
  //  - Money fields: Decimal(19, 4)
  //  - Rates / multiples / weights: Decimal(9, 6)
  ebitdaDecimal            Decimal? @db.Decimal(19, 4)
  multiplierDecimal        Decimal? @db.Decimal(9,  6)
  growthRateDecimal        Decimal? @db.Decimal(9,  6)
  dcfYear1Decimal          Decimal? @db.Decimal(19, 4)
  dcfYear2Decimal          Decimal? @db.Decimal(19, 4)
  dcfYear3Decimal          Decimal? @db.Decimal(19, 4)
  dcfYear4Decimal          Decimal? @db.Decimal(19, 4)
  dcfYear5Decimal          Decimal? @db.Decimal(19, 4)
  terminalGrowthDecimal    Decimal? @db.Decimal(9,  6)
  discountRateDecimal      Decimal? @db.Decimal(9,  6)
  riskFreeRateDecimal      Decimal? @db.Decimal(9,  6)
  equityRiskPremiumDecimal Decimal? @db.Decimal(9,  6)
  sizePremiumDecimal       Decimal? @db.Decimal(9,  6)
  specificRiskDecimal      Decimal? @db.Decimal(9,  6)
  indicatedValueDecimal    Decimal? @db.Decimal(19, 4)
  weightDecimal            Decimal? @db.Decimal(9,  6)
  // Slice 7 — valuation assumptions (WACC components, multiples, DCF cash
  // flows) can eventually be traced back to source evidence. The relation
  // is here now; UI wire-in is a future slice.
  citations                EvidenceCitation[]

  createdAt        DateTime @default(now())
}

// ─────────────────────────────────────────────────
// FORENSIC ANOMALY FLAGS
// ─────────────────────────────────────────────────

model AnomalyFlag {
  id           String   @id @default(cuid())
  caseId       String
  case         Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  severity     String   // HIGH | MEDIUM | LOW
  category     String   // BENFORD | OUTLIER | RELATED_PARTY | RATIO_BREAK | DUPLICATE | MARGIN_SHIFT
  title        String
  description  String   @db.Text
  affectedRows String?  @db.Text // JSON array of FinancialValue IDs
  status       String   @default("OPEN") // OPEN | INVESTIGATED | EXPLAINED | ESCALATED
  resolution   String?  @db.Text
  resolvedBy   String?
  resolvedAt   DateTime?
  createdAt    DateTime @default(now())
}

// ─────────────────────────────────────────────────
// PROACTIVE AI INSIGHTS
// ─────────────────────────────────────────────────

model CaseInsight {
  id          String   @id @default(cuid())
  caseId      String
  case        Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  type        String   // ANOMALY | MISSING_DOC | SUGGESTION | WARNING | COMPLETION
  title       String
  body        String   @db.Text
  actionLabel String?
  actionPath  String?
  isDismissed Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// ─────────────────────────────────────────────────
// AUDIT TRAIL (chain of custody)
// ─────────────────────────────────────────────────

model AuditLog {
  id          String   @id @default(cuid())
  caseId      String?
  case        Case?    @relation(fields: [caseId], references: [id])
  // Slice 2 — auth events like LOGIN_FAIL for an unknown email have no user.
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  action      String   // UPLOAD_DOC | RUN_EXTRACTION | ACCEPT_VALUE | OVERRIDE_VALUE | REJECT_VALUE | LOCK_VALUE | APPROVE_BATCH | CREATE_CASE | GENERATE_REPORT | RUN_ANOMALY | LOGIN_* | LOGOUT | PASSWORD_* | etc.
  targetModel String?  // "FinancialValue" | "Document" | "AddBack" | "ValuationModel"
  targetId    String?
  oldValue    String?  @db.Text  // JSON
  newValue    String?  @db.Text  // JSON
  note        String?  @db.Text
  ipAddress   String?
  createdAt   DateTime @default(now())
  // ── Slice 6: tamper-evident hash chain ───────────────────────────────
  // Rows written before Slice 6 have all of these NULL and are treated by
  // the verifier as "pre-chain" (skipped, not counted as tamper). New
  // events form a chain keyed by `chainKey` and ordered by `sequence`.
  // `eventHash` = SHA-256(canonicalPayload including previousHash).
  chainKey     String?  // 'org:<id>' | 'global:anon'
  sequence     Int?     // per-chainKey monotonic; enforced by @@unique below
  previousHash String?  @db.VarChar(64)   // hex sha-256, or null for the genesis row
  eventHash    String?  @db.VarChar(64)
  hashVersion  String?  @db.VarChar(8)    // 'v1' for the current canonical format

  @@index([caseId, createdAt])
  @@index([userId])
  @@index([action, createdAt])
  @@index([chainKey, sequence])
  @@unique([chainKey, sequence], name: "AuditLog_chainKey_sequence_key")
}

// ─────────────────────────────────────────────────
// EXTERNAL CONNECTORS
// ─────────────────────────────────────────────────

model ExternalConnector {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  provider       String
  // Legacy plaintext columns retained during migration to envelope encryption.
  // Cleared on every new write by encryptConnectorSecrets(). Rows that still
  // carry plaintext here have not yet been passed through the Slice 3
  // migration script.
  accessToken    String?      @db.Text
  refreshToken   String?      @db.Text
  // Slice 3 — envelope-encrypted secrets.
  // Shape: { version: 'v1', secrets: { <name>: { ciphertext, dek } } }
  encryptedSecrets     Json?
  // Which KEK produced the wrap ('kms:<arn>' or 'local-v1'); used by
  // rotation queries to find rows still keyed to an old KEK.
  encryptionKeyVersion String?
  expiresAt      DateTime?
  status         String       @default("CONNECTED")
  lastSync       DateTime?    @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, provider])
  @@index([encryptionKeyVersion])
}

// ─────────────────────────────────────────────────
// AUTH HARDENING (Slice 2)
// ─────────────────────────────────────────────────

// Records the jti of each revoked session JWT so getSession() can reject
// cookies that are otherwise cryptographically valid. Rows are pruned
// after their originating token's natural expiry.
model SessionRevocation {
  jti        String   @id                    // JWT jti
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  reason     String                          // LOGOUT | PASSWORD_CHANGE | ADMIN | SUSPICIOUS
  revokedAt  DateTime @default(now())
  expiresAt  DateTime                        // when the underlying JWT would've expired

  @@index([expiresAt])
  @@index([userId])
}

// SHA-256(raw token) is the primary key — the raw token exists only in
// the outgoing email. Consumed tokens are retained (audit trail) but
// cannot be re-used because of the consumedAt check.
model PasswordResetToken {
  tokenHash  String    @id
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, expiresAt])
}

model EmailVerificationToken {
  tokenHash  String    @id
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, expiresAt])
}

// One row per real login attempt (rejected-by-rate-limit attempts do NOT
// write here — they only emit an AuditLog LOGIN_RATE_LIMITED event).
// Used by the rate limiter and by anomaly-detection dashboards.
model LoginAttempt {
  id         String   @id @default(cuid())
  email      String                          // normalized lowercase
  ipAddress  String?
  ok         Boolean
  reason     String?                         // BAD_PASSWORD | UNKNOWN_USER | MFA_FAIL
  createdAt  DateTime @default(now())

  @@index([email, createdAt])
  @@index([createdAt])
}

// TOTP shared secret. verifiedAt remains null while enrollment is
// pending; a successful first code sets it.
model MfaSecret {
  userId     String    @id
  user       User      @relation(fields: [userId], references: [id])
  secret     String                          // base32 TOTP shared secret
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// Single-use recovery codes; codeHash = SHA-256(plaintext). Used codes
// are retained for audit but cannot be re-consumed.
model MfaBackupCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ─────────────────────────────────────────────────
// EVIDENCE CITATIONS (Slice 7)
// ─────────────────────────────────────────────────
// A citation ties a material forensic value (FinancialValue, AddBack, or
// a valuation assumption on ValuationModel) back to a specific,
// *immutable* DocumentVersion. Slice 5's version model guarantees that a
// citation to v2 remains valid even when v3 supersedes it — the bytes
// referenced by v2 don't change.
//
// isConfident is the anti-hallucination guard. When the AI can't
// confidently locate a value, it emits a citation with isConfident=false
// and NULLs the coordinate fields. The row still exists so the UI can
// distinguish "AI tried but couldn't locate" from "no citation attempt
// at all". Rule 9.
model EvidenceCitation {
  id                String   @id @default(cuid())
  documentVersionId String
  documentVersion   DocumentVersion @relation(fields: [documentVersionId], references: [id])

  // Polymorphic parent — exactly one of these is set per row. Enforced
  // by application logic (see src/lib/citations/parent.ts) since Prisma
  // does not have a native discriminated-relation type.
  financialValueId  String?
  financialValue    FinancialValue? @relation(fields: [financialValueId], references: [id], onDelete: Cascade)
  addBackId         String?
  addBack           AddBack?        @relation(fields: [addBackId], references: [id], onDelete: Cascade)
  valuationModelId  String?
  valuationModel    ValuationModel? @relation(fields: [valuationModelId], references: [id], onDelete: Cascade)

  // Location within the source document.
  pageNumber        Int?
  sourceLabel       String?  // human-readable, e.g. "Income Statement, row 'Gross Revenue'"
  tableName         String?
  rowLabel          String?
  columnLabel       String?
  // Optional structured bounding box: { x, y, w, h, unit: 'norm'|'pt'|'px' }.
  // Different extractors use different conventions; we record the unit
  // alongside the coordinates so the renderer can interpret them.
  boundingBox       Json?

  // Raw substring captured at extraction time.
  rawText           String?  @db.Text

  // Extractor provenance.
  extractor         String?  // 'ai-genkit-v1' | 'analyst' | 'legacy-backfill'
  extractorVersion  String?
  confidence        Float?

  // Anti-hallucination flag. False when the AI (or legacy backfill) had
  // to record a citation without being able to pin the actual location.
  isConfident       Boolean  @default(true)

  createdAt         DateTime @default(now())

  @@index([documentVersionId])
  @@index([financialValueId])
  @@index([addBackId])
  @@index([valuationModelId])
}

// ─────────────────────────────────────────────────
// AI EXECUTION REGISTRY (Slice 8)
// ─────────────────────────────────────────────────
// Every user-triggered AI flow invocation writes exactly one row here.
// The row records who ran what, against which document versions, and
// what came out — WITHOUT ever storing the raw prompt, the raw model
// output, or the document bytes. The input hash is computed after
// scrubbing data URIs and known secret keys.
//
// Values proposed by an AI run link back via FinancialValue.aiExecutionId,
// so any material fact can be traced to a single execution + a single
// prompt-template hash + a single set of source DocumentVersion IDs.
model AiExecution {
  id                 String   @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id])
  caseId             String?
  case               Case?    @relation(fields: [caseId], references: [id])
  userId             String
  user               User     @relation(fields: [userId], references: [id])

  // Flow identity
  flowName           String   // 'financialDocumentExtractionFlow' | ...
  flowVersion        String?  // human label, bumped alongside the prompt
  promptTemplateHash String?  // sha256 of the prompt template body, auto-computed
  promptTemplateKey  String?  // stable key that survives whitespace edits

  // Model identity
  modelProvider      String   // 'googleai'
  modelName          String   // 'gemini-2.5-flash'
  modelVersion       String?  // if the API exposes one

  // Data provenance (never the document bytes themselves)
  inputHash          String   // sha256 of the scrubbed canonicalized input
  outputHash         String?  // sha256 of the canonicalized output (null on failure)
  // JSON array of DocumentVersion ids that fed this execution. Slice 5
  // guarantees those versions are immutable, so this list is enough to
  // reproduce the source-document identity of any given run.
  documentVersionIds Json?

  // Timing + status
  startedAt          DateTime @default(now())
  completedAt        DateTime?
  durationMs         Int?
  status             String   @default("RUNNING") // RUNNING | SUCCESS | FAILURE
  errorCategory      String?  // MODEL_TIMEOUT | SCHEMA_VALIDATION | RATE_LIMIT | REFUSED | INFRA | UNKNOWN
  errorMessage       String?  @db.Text

  // Cost / tokens — optional; populated when the model exposes them.
  inputTokens        Int?
  outputTokens       Int?
  totalTokens        Int?
  estimatedCostUsd   Decimal? @db.Decimal(10, 6)

  // Aggregate human review of the run. Individual FinancialValue
  // reviewStatus already tracks per-row acceptance; this column is the
  // "execution as a whole" verdict, updated explicitly (not derived).
  reviewStatus       String   @default("PENDING") // PENDING | ACCEPTED | REJECTED | OVERRIDDEN | MIXED
  reviewedBy         String?
  reviewedAt         DateTime?

  createdAt          DateTime @default(now())

  financialValues    FinancialValue[]
  // Slice 12 — request-item completeness detection runs.
  requestItems       RequestItem[]

  @@index([organizationId, createdAt])
  @@index([caseId, createdAt])
  @@index([userId])
  @@index([flowName, createdAt])
  @@index([status])
}

// ─────────────────────────────────────────────────
// TIE-OUT ENGINE (Slice 9)
// ─────────────────────────────────────────────────
// A TieOut represents one reconciliation task: a specific (concept, year)
// pair on a specific case, e.g. "Revenue for 2024". Its TieOutItem rows
// hold the individual values pulled from different evidence sources
// (Tax Return, P&L, GL, Bank Confirmation, ...).
//
// Status is computed from the item values + the tolerance rules on the
// tie-out itself. The verdict is one of:
//   TIED               all items numerically equal
//   WITHIN_TOLERANCE   max pairwise difference within tolerance
//   DISCREPANCY        outside tolerance; needs analyst review
//   UNRESOLVED         < 2 items — can't reconcile a single source
//   RESOLVED           analyst has explicitly resolved a DISCREPANCY;
//                      the row remains visible (never auto-hidden)
//
// Tolerance is per-tie-out with per-concept defaults. Both an absolute
// dollar tolerance and a percent-of-median tolerance are supported; a
// difference is "within tolerance" if it satisfies EITHER.
model TieOut {
  id                String   @id @default(cuid())
  caseId            String
  case              Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  concept           String   // REVENUE | EBITDA | NET_INCOME | CASH | ACCOUNTS_RECEIVABLE | ACCOUNTS_PAYABLE | TOTAL_ASSETS | TOTAL_LIABILITIES
  year              String   // 'TTM' | '2024' | ...

  // Tolerance rules. NULL means "use the default for this concept".
  toleranceAbsolute Decimal? @db.Decimal(19, 4)
  tolerancePercent  Decimal? @db.Decimal(9,  6)   // 0.001 = 0.1%

  status            String   @default("UNRESOLVED") // TIED | WITHIN_TOLERANCE | DISCREPANCY | UNRESOLVED | RESOLVED
  // Max pairwise absolute difference across the items. Cached for the
  // dashboard sort; the authoritative source is always the items.
  maxDifference     Decimal? @db.Decimal(19, 4)

  // Reviewer resolution
  resolvedBy        String?  // userId
  resolvedAt        DateTime?
  resolutionNote    String?  @db.Text

  items             TieOutItem[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // A given (case, concept, year) has exactly one TieOut. Re-running the
  // builder upserts existing rows so a case never grows duplicate
  // reconciliations for the same fact.
  @@unique([caseId, concept, year])
  @@index([caseId, status])
  @@index([status])
}

model TieOutItem {
  id                String   @id @default(cuid())
  tieOutId          String
  tieOut            TieOut   @relation(fields: [tieOutId], references: [id], onDelete: Cascade)

  sourceLabel       String   // 'Income Statement' | 'Tax Return' | 'GL' | 'Bank' | ...
  value             Decimal  @db.Decimal(19, 4)

  // Optional back-links to the source. Both are SetNull because the
  // TieOut is the entity of record for the reconciliation history —
  // deleting a FinancialValue must not erase the audit trail.
  financialValueId  String?
  financialValue    FinancialValue?  @relation(fields: [financialValueId], references: [id], onDelete: SetNull)
  documentVersionId String?
  documentVersion   DocumentVersion? @relation(fields: [documentVersionId], references: [id], onDelete: SetNull)

  createdAt         DateTime @default(now())

  @@index([tieOutId])
  @@index([financialValueId])
  @@index([documentVersionId])
}

// ─────────────────────────────────────────────────
// ENGAGEMENT TEAM + REVIEW WORKFLOW (Slice 11)
// ─────────────────────────────────────────────────

// CaseMember binds a user to a case with an engagement role. When
// Case.hasEngagementTeam is true, the union of active CaseMembers plus
// org-level ADMINs is the exclusive access set for the case. See
// docs/architecture/CASE_TEAM_REVIEW_WORKFLOW.md for the two-layer
// authz composition.
model CaseMember {
  id           String    @id @default(cuid())
  caseId       String
  case         Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  // Engagement role — distinct from org-level RBAC role.
  //   ENGAGEMENT_PARTNER | MANAGER | SENIOR | ANALYST | REVIEWER |
  //   READ_ONLY | EXTERNAL_COLLABORATOR
  caseRole     String
  addedBy      String?   // userId of the person who added this member
  addedAt      DateTime  @default(now())
  // Soft-delete: setting removedAt disables access without erasing history.
  removedAt    DateTime?
  removedBy    String?

  @@unique([caseId, userId], name: "CaseMember_case_user")
  @@index([caseId])
  @@index([userId])
}

// A ReviewItem attaches a review lifecycle to any material target on a
// case: financial values, add-backs, valuation assumptions, tie-out
// discrepancies, report sections, documents. Polymorphic parent via
// (targetType, targetId). Exactly one review item per target.
model ReviewItem {
  id                  String   @id @default(cuid())
  caseId              String
  case                Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  // Which material target this review references.
  //   FINANCIAL_VALUE | ADDBACK | VALUATION_MODEL | ANOMALY_FLAG |
  //   REPORT_SECTION | DOCUMENT | TIE_OUT
  targetType          String
  targetId            String

  status              String   @default("DRAFT") // DRAFT | READY_FOR_REVIEW | CHANGES_REQUESTED | APPROVED
  title               String
  description         String?  @db.Text

  createdBy           String   // userId
  assignedTo          String?  // userId — reviewer
  approvedBy          String?
  approvedAt          DateTime?
  changesRequestedBy  String?
  changesRequestedAt  DateTime?
  changesRequestedNote String? @db.Text

  comments            ReviewComment[]

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([caseId, targetType, targetId], name: "ReviewItem_case_target")
  @@index([caseId, status])
  @@index([status])
  @@index([assignedTo])
}

// Append-only conversation on a review item. No edits, no deletes at
// the app layer — the review record is part of the audit trail.
model ReviewComment {
  id            String   @id @default(cuid())
  reviewItemId  String
  reviewItem    ReviewItem @relation(fields: [reviewItemId], references: [id], onDelete: Cascade)
  authorId      String
  author        User     @relation(fields: [authorId], references: [id])
  body          String   @db.Text
  createdAt     DateTime @default(now())

  @@index([reviewItemId, createdAt])
}

// ─────────────────────────────────────────────────
// CLIENT REQUEST LIST & SECURE PORTAL (Slice 12)
// ─────────────────────────────────────────────────
// A firm collects "prepared-by-client" (PBC) documents through a
// RequestList attached to a Case. Each RequestList is composed of
// RequestItems (individual asks). Items have a lifecycle status
// (NOT_REQUESTED → REQUESTED → RECEIVED → NEEDS_CLARIFICATION →
//  RECEIVED → ACCEPTED / NOT_APPLICABLE) and can carry multiple
// uploaded documents.
//
// Clients access their assigned RequestList via an opaque URL token.
// The raw token exists only in the emailed link; only its SHA-256 hash
// is stored in `PortalAccess`. A portal caller NEVER gets a firm
// session — they see only their own list, and only the RequestItem
// rows scoped to it.
//
// See docs/architecture/CLIENT_PORTAL_REQUESTS.md for the security
// model and the "no cross-scope" invariant.
model RequestList {
  id            String   @id @default(cuid())
  caseId        String
  case          Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  title         String
  description   String?  @db.Text
  // DRAFT while the firm is still assembling the list. SENT once at
  // least one PortalAccess has been issued. CLOSED when the analyst
  // marks the collection complete.
  status        String   @default("DRAFT")   // DRAFT | SENT | CLOSED
  createdBy     String   // firm userId
  templateId    String?  // origin template, for provenance
  template      RequestTemplate? @relation(fields: [templateId], references: [id])
  sentAt        DateTime?
  closedAt      DateTime?
  items         RequestItem[]
  portalAccesses PortalAccess[]
  reminderEvents ReminderEvent[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([caseId, status])
  @@index([templateId])
}

model RequestItem {
  id                 String   @id @default(cuid())
  requestListId      String
  requestList        RequestList @relation(fields: [requestListId], references: [id], onDelete: Cascade)
  // Denormalized for tenant-scoping queries + dashboards.
  caseId             String
  case               Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  title              String
  description        String?  @db.Text
  category           String?  // FINANCIAL | TAX | BANK | LEGAL | OPERATIONS | GOVERNANCE | HR | OTHER
  requestedFrom      String?  // free-form: "Client", "CFO", "Owner Compensation Committee", etc.
  dueDate            DateTime?
  priority           String   @default("NORMAL")   // LOW | NORMAL | HIGH
  status             String   @default("NOT_REQUESTED")
  //   NOT_REQUESTED       — analyst hasn't sent this to the client
  //   REQUESTED           — SENT and awaiting client action
  //   RECEIVED            — client uploaded at least one document
  //   NEEDS_CLARIFICATION — reviewer flagged that upload as insufficient
  //   ACCEPTED            — reviewer signed off
  //   NOT_APPLICABLE      — reviewer determined this item doesn't apply
  assignedToUserId   String?  // firm professional assigned to review
  reviewerUserId     String?  // firm reviewer (may equal assignedTo)
  notes              String?  @db.Text          // firm-internal notes; NEVER shown to portal
  clarificationNote  String?  @db.Text          // shown to portal when NEEDS_CLARIFICATION
  // ── AI-assisted completeness detection ────────────────────────────
  // Populated by runCompletenessCheck; NEVER auto-transitions the
  // status to ACCEPTED. Only a suggestion visible to the reviewer.
  //   AUTO_COMPLETE       — AI believes upload satisfies the request
  //   NEEDS_HUMAN         — AI is not confident; human must judge
  //   INSUFFICIENT        — AI believes upload does not satisfy the request
  aiCompleteness     String?
  // Anti-hallucination flag (Slice 7 pattern). When false, aiCompleteness
  // must be surfaced as a suggestion the human explicitly reviews.
  aiCompletenessConfident Boolean @default(true)
  aiCompletenessNote String? @db.Text
  aiExecutionId      String?
  aiExecution        AiExecution? @relation(fields: [aiExecutionId], references: [id])
  documents          RequestItemDocument[]
  reminders          ReminderEvent[]
  statusChangedAt    DateTime?
  displayOrder       Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([requestListId, status])
  @@index([caseId, status])
  @@index([status])
  @@index([aiExecutionId])
}

// Join between RequestItem and Document. A single document can satisfy
// multiple items in principle (e.g. a comprehensive tax return covers
// several asks) so the join is many-to-many; the unique guards duplicate
// links.
model RequestItemDocument {
  id               String   @id @default(cuid())
  requestItemId    String
  requestItem      RequestItem @relation(fields: [requestItemId], references: [id], onDelete: Cascade)
  documentId       String
  document         Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  // True when the upload originated on the client portal (not a firm
  // user manually attaching a doc). Preserves origin for the audit
  // trail even after the PortalAccess is revoked.
  uploadedByPortal Boolean  @default(false)
  uploadedByContactId String?  // ClientContact.id (nullable when firm-side)
  uploadedAt       DateTime @default(now())

  @@unique([requestItemId, documentId])
  @@index([documentId])
}

// A person on the client's side. Distinct from `User` — a ClientContact
// never has a firm password, JWT session, or org role.
model ClientContact {
  id            String   @id @default(cuid())
  caseId        String
  case          Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  name          String
  email         String   // normalized lowercase at write time
  role          String?  // free-form: "Owner", "CFO", "Bookkeeper", ...
  createdBy     String   // firm userId
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  portalAccesses PortalAccess[]
  reminderEvents ReminderEvent[]

  @@index([caseId])
  @@index([caseId, email])
}

// A per-invitation opaque token that grants a single ClientContact
// scoped access to a single RequestList. The primary key is the SHA-256
// hex hash of the raw token; the raw token exists only in the emailed
// URL. Portal server actions look up the row by hashing the incoming
// token — a DB dump therefore never leaks a usable portal link.
model PortalAccess {
  tokenHash        String   @id
  clientContactId  String
  clientContact    ClientContact @relation(fields: [clientContactId], references: [id], onDelete: Cascade)
  requestListId    String
  requestList      RequestList @relation(fields: [requestListId], references: [id], onDelete: Cascade)
  // Denormalized for tenant-scoping queries + audit-log ergonomics.
  caseId           String
  case             Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  invitedBy        String   // firm userId who issued the invite
  invitedAt        DateTime @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  revokedBy        String?
  lastUsedAt       DateTime?
  usageCount       Int      @default(0)
  lastUsedIp       String?

  @@index([requestListId])
  @@index([clientContactId])
  @@index([caseId])
  @@index([expiresAt])
}

// Log of every reminder / notification touching a request. Both a
// rate-limit source (queries by `sentAt`) and an audit signal.
model ReminderEvent {
  id             String   @id @default(cuid())
  caseId         String
  case           Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  requestListId  String?
  requestList    RequestList? @relation(fields: [requestListId], references: [id], onDelete: Cascade)
  requestItemId  String?
  requestItem    RequestItem? @relation(fields: [requestItemId], references: [id], onDelete: Cascade)
  clientContactId String?
  clientContact   ClientContact? @relation(fields: [clientContactId], references: [id])
  //   INVITE          — first portal link email
  //   REMINDER        — subsequent nudge
  //   CLARIFICATION   — reviewer requested clarification
  //   RECEIVED_ACK    — firm confirmed receipt / acceptance
  kind           String
  channel        String   @default("EMAIL")   // EMAIL | INAPP
  toEmail        String?
  sentBy         String?  // firm userId; NULL for system / scheduled
  sentAt         DateTime @default(now())
  status         String   @default("SENT")    // SENT | FAILED | SUPPRESSED
  errorMessage   String?  @db.Text

  @@index([caseId, sentAt])
  @@index([requestListId, sentAt])
  @@index([requestItemId, sentAt])
  @@index([clientContactId, sentAt])
}

// Firm-editable template of a request list. Seeded system templates
// (`isSystem = true`) cannot be deleted but may be cloned. Firms can
// author their own templates for their common engagement types.
model RequestTemplate {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?  @db.Text
  engagementType String?  // BUSINESS_VALUATION | DIVORCE | LITIGATION | ESTATE | OTHER
  isSystem       Boolean  @default(false)
  createdBy      String?
  items          RequestTemplateItem[]
  requestLists   RequestList[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, engagementType])
}

model RequestTemplateItem {
  id             String   @id @default(cuid())
  templateId     String
  template       RequestTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  title          String
  description    String?  @db.Text
  category       String?
  priority       String   @default("NORMAL")
  displayOrder   Int      @default(0)

  @@index([templateId])
}

